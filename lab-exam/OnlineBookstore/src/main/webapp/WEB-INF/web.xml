<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>
  <servlet>
  	<servlet-name>BookRegisterServlet</servlet-name>
  	<display-name>BookRegisterServlet</display-name>
  	<description></description>
  	<servlet-class>books.BookRegisterServlet</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>DisplayBooksServlet</servlet-name>
  	<display-name>DisplayBooksServlet</display-name>
  	<description></description>
  	<servlet-class>books.DisplayBooksServlet</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>DeleteBookServlet</servlet-name>
  	<display-name>DeleteBookServlet</display-name>
  	<description></description>
  	<servlet-class>books.DeleteBookServlet</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>SearchBookServlet</servlet-name>
  	<display-name>SearchBookServlet</display-name>
  	<description></description>
  	<servlet-class>books.SearchBookServlet</servlet-class>
  </servlet>
  <servlet-mapping>
  	<servlet-name>BookRegisterServlet</servlet-name>
  	<url-pattern>/BookRegisterServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>DisplayBooksServlet</servlet-name>
  	<url-pattern>/DisplayBooksServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>DeleteBookServlet</servlet-name>
  	<url-pattern>/DeleteBookServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>SearchBookServlet</servlet-name>
  	<url-pattern>/SearchBookServlet</url-pattern>
  </servlet-mapping>
</web-app>
